#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    vector<int>v(n+1);
    for(int i=1; i<=n; i++){
        cin>>v[i];
        v[i]+=v[i-1];
    }
    
    
    int max_subarray_sum=v[1], min_prefix_sum=v[0];
    for(int i=1; i<=n; i++){
        max_subarray_sum = max(max_subarray_sum, v[i]- min_prefix_sum);
        min_prefix_sum = min(min_prefix_sum, v[i]);
    }
    
    cout<<max_subarray_sum;
}
